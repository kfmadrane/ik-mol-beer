generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Letter {
  id        String   @id @default(cuid())
  symbol    String   @unique
  audioPath String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Word {
  id        String   @id @default(cuid())
  text      String   @unique
  imagePath String?
  audioPath String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
